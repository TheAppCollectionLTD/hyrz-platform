PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# For production, set this to the exact deployed frontend origin (or comma-separated trusted origins).
APP_URL=http://localhost:5173
EMAIL_FROM=Hyrz <notifications@example.com>
# Configure a verified sender and API key to enable verification, password reset and invoice reminder emails.
RESEND_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
