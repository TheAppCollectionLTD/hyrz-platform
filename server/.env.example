IDENTIFIER_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hyrz
DB_USER=hyrz_app
