{
  "project_name": "hyrz - UK Flexible Staffing Platform",
  "theme_archetype": "Midnight and Sunshine (Confident, Modern & Festival-Friendly)",
  "app_type": "saas_app",
  "roles": ["worker", "employer", "admin"],
  "design_system_tokens": {
    "colors": {
      "primary_navy": "#0F1B2D",
      "navy_surface_light": "#1A293E",
      "navy_border": "#283A52",
      "sky_blue": "#4DA3FF",
      "sky_blue_button": "#2272EB",
      "sky_blue_button_hover": "#1D5EC2",
      "sunshine_yellow": "#FFC93C",
      "sunshine_yellow_hover": "#E5B22B",
      "sunshine_text_color": "#0F1B2D",
      "off_white_bg": "#F7F8FA",
      "card_surface_white": "#FFFFFF",
      "text_primary": "#0F1B2D",
      "text_secondary": "#5A6B82",
      "text_muted": "#8A99AD",
      "text_inverse": "#F7F8FA",
      "border_default": "#E2E8F0",
      "border_subtle": "#EDF2F7",
      "status": {
        "success": {
          "bg": "#E6F4EA",
          "text": "#137333",
          "border": "#A8DADC"
        },
        "warning": {
          "bg": "#FFF8E1",
          "text": "#B45309",
          "border": "#FDE68A"
        },
        "danger": {
          "bg": "#FCE8E6",
          "text": "#C5221F",
          "border": "#F87171"
        },
        "info": {
          "bg": "#EBF5FF",
          "text": "#1D4ED8",
          "border": "#BFDBFE"
        }
      }
    },
    "typography": {
      "font_family_heading": "'Outfit', 'Plus Jakarta Sans', sans-serif",
      "font_family_body": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
      "font_family_mono": "'JetBrains Mono', monospace",
      "scale": {
        "hero": "text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight",
        "h1": "text-3xl sm:text-4xl font-bold tracking-tight",
        "h2": "text-2xl sm:text-3xl font-bold tracking-tight",
        "h3": "text-xl sm:text-2xl font-semibold",
        "h4": "text-lg font-semibold",
        "body_large": "text-lg font-normal leading-relaxed",
        "body": "text-base font-normal leading-normal",
        "caption": "text-sm text-secondary font-medium",
        "label": "text-xs font-semibold uppercase tracking-wider"
      }
    },
    "radii": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "xl": "24px",
      "full": "9999px"
    },
    "shadows": {
      "subtle": "0 2px 8px rgba(15, 27, 45, 0.04)",
      "card": "0 4px 16px rgba(15, 27, 45, 0.06)",
      "dropdown": "0 10px 30px rgba(15, 27, 45, 0.12)",
      "glow_sunshine": "0 4px 20px rgba(255, 201, 60, 0.35)",
      "glow_sky": "0 4px 20px rgba(77, 163, 255, 0.25)"
    }
  },
  "layout_specifications": {
    "desktop": {
      "min_breakpoint": "1024px",
      "sidebar": {
        "width": "260px",
        "bg_color": "#0F1B2D",
        "text_color": "#F7F8FA",
        "logo_area": "Height 72px, bold sunshine yellow emblem (#FFC93C) with white text",
        "active_nav_item": "bg: #1A293E, text: #FFC93C, border-left: 4px solid #FFC93C",
        "hover_nav_item": "bg: #162438, text: #4DA3FF",
        "user_card_bottom": "Border-top: 1px solid #283A52, avatar with sunshine badge, sign-out button"
      },
      "main_container": {
        "bg_color": "#F7F8FA",
        "max_width": "1440px",
        "padding": "p-6 lg:p-10",
        "dashboard_grid": "grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      },
      "chat_split_view": {
        "list_width": "340px",
        "detail_flex": "flex-1",
        "border": "1px solid #E2E8F0"
      }
    },
    "mobile": {
      "max_breakpoint": "1023px",
      "bottom_nav": {
        "height": "64px",
        "bg_color": "#0F1B2D",
        "border_top": "1px solid #283A52",
        "active_icon_color": "#FFC93C",
        "inactive_icon_color": "#8A99AD"
      }
    }
  },
  "chat_theme_tokens": {
    "header": {
      "bg": "#0F1B2D",
      "text": "#FFFFFF",
      "status_indicator": "#4DA3FF"
    },
    "wall_background": "#F0F4F8",
    "own_bubble": {
      "bg": "#0F1B2D",
      "text": "#FFFFFF",
      "timestamp": "#8A99AD",
      "ticks": "#FFC93C"
    },
    "other_bubble": {
      "bg": "#FFFFFF",
      "text": "#0F1B2D",
      "border": "#E2E8F0",
      "timestamp": "#5A6B82"
    },
    "composer": {
      "bg": "#FFFFFF",
      "border": "#E2E8F0",
      "send_button_bg": "#FFC93C",
      "send_button_text": "#0F1B2D"
    }
  },
  "components_spec": {
    "buttons": {
      "primary": "bg-[#FFC93C] text-[#0F1B2D] font-bold hover:bg-[#E5B22B] shadow-sm rounded-md transition-all active:scale-[0.98]",
      "secondary": "bg-[#2272EB] text-white font-semibold hover:bg-[#1D5EC2] shadow-sm rounded-md transition-all",
      "outline": "border border-[#283A52] text-[#0F1B2D] hover:bg-[#F7F8FA] rounded-md transition-all"
    },
    "cards": "bg-white border border-[#E2E8F0] rounded-xl p-6 shadow-card hover:shadow-lg transition-shadow",
    "status_pills": "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider",
    "inputs": "w-full px-4 py-2.5 bg-white border border-[#E2E8F0] rounded-lg focus:ring-2 focus:ring-[#4DA3FF] focus:border-transparent outline-none transition-all"
  },
  "image_urls": {
    "bartenders_team": "https://images.unsplash.com/photo-1758526348403-b729c700d675?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA4Mzl8MHwxfHNlYXJjaHwyfHxmZXN0aXZhbCUyMGhvc3BpdGFsaXR5JTIwd29ya2VycyUyMHRlYW18ZW58MHx8fHwxNzkzODg3MzAxfDA&ixlib=rb-4.1.0&q=85",
    "staff_uniform": "https://images.unsplash.com/photo-1641122669951-3e2aff778d3b?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA4Mzl8MHwxfHNlYXJjaHwxfHxmZXN0aXZhbCUyMGhvc3BpdGFsaXR5JTIwd29ya2VycyUyMHRlYW18ZW58MHx8fHwxNzkzODg3MzAxfDA&ixlib=rb-4.1.0&q=85"
  },
  "instructions_to_main_agent": [
    "Apply Midnight (#0F1B2D) and Sunshine (#FFC93C) palette across all worker, employer, and admin interfaces.",
    "Implement the left sidebar fixed layout for desktop screens (>=1024px) with quick navigation items for all 3 roles.",
    "Re-theme the chat component with dark navy own-bubbles, sunshine accent send buttons, and crisp split-view.",
    "Ensure all interactive elements have explicit data-testid attributes for testing."
  ],
  "UNIVERSAL GUIDELINES FOR MAIN AGENT": [
    "Never use generic centered layouts or unstyled default components.",
    "Always maintain contrast accessibility: sunshine yellow button text must be dark navy (#0F1B2D).",
    "Use data-testid in kebab-case on all action buttons, inputs, tabs, and status cards."
  ]
}